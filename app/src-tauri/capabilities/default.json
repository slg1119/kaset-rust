{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local UI in the main window. The login window has no capability, so its remote pages cannot call any command.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "allow-auth-status",
    "allow-sign-in",
    "allow-sign-out",
    "allow-get-feed",
    "allow-get-feed-category",
    "allow-get-feed-chip",
    "allow-get-feed-continuation",
    "allow-get-browse-page",
    "allow-get-artist",
    "allow-get-artist-more",
    "allow-play-artist-mix",
    "allow-get-lyrics",
    "allow-search",
    "allow-search-continuation",
    "allow-search-suggestions",
    "allow-get-account",
    "allow-window-vibrancy",
    "allow-play-queue",
    "allow-toggle-playback",
    "allow-next-track",
    "allow-previous-track",
    "allow-seek-to",
    "allow-set-repeat",
    "allow-set-shuffle",
    "allow-player-snapshot"
  ]
}
